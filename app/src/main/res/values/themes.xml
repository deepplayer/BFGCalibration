<resources xmlns:tools="http://schemas.android.com/tools">
    
    <style name="Theme.BlackBox" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        
        <item name="colorSecondary">@color/primary_light</item>
        <item name="colorSecondaryVariant">@color/primary</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        
        <item name="android:statusBarColor" tools:targetApi="l">?attr/colorPrimaryVariant</item>
        <item name="android:navigationBarColor" tools:targetApi="o_mr1">@color/background</item>
        <item name="android:windowBackground">@color/background</item>
        

        <item name="actionMenuTextColor">@color/on_surface</item>
    </style>

    <style name="ToolBarColorStyle" parent="ThemeOverlay.AppCompat.ActionBar">
        <item name="actionMenuTextColor">@color/white</item>
        <item name="colorControlNormal">@color/white</item>
    </style>

    <style name="WelcomeTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/splash</item>
    </style>

    <style name="Theme.BlackBox.Ninebot" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/ninebot_blue</item>
        <item name="colorPrimaryVariant">@color/ninebot_blue_dark</item>
        <item name="colorOnPrimary">@color/ninebot_on_blue</item>
        <item name="colorSecondary">@color/ninebot_blue</item>
        <item name="colorOnSecondary">@color/ninebot_on_blue</item>
        <item name="android:colorBackground">@color/ninebot_background</item>
        <item name="colorOnBackground">@color/ninebot_text</item>
        <item name="colorSurface">@color/ninebot_surface</item>
        <item name="colorOnSurface">@color/ninebot_text</item>
        <item name="android:textColorPrimary">@color/ninebot_text</item>
        <item name="android:textColorSecondary">@color/ninebot_muted</item>
        <item name="android:textColorHint">@color/ninebot_muted</item>
        <item name="android:windowBackground">@color/ninebot_background</item>
        <item name="android:statusBarColor">@color/ninebot_surface</item>
        <item name="android:navigationBarColor">@color/ninebot_surface</item>
        <item name="android:windowLightStatusBar">@bool/ninebot_light_system_bars</item>
        <item name="android:windowLightNavigationBar">@bool/ninebot_light_system_bars</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:fontFamily">sans</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.BlackBox.Ninebot.MaterialAlertDialog</item>
    </style>

    <style name="ThemeOverlay.BlackBox.Ninebot.MaterialAlertDialog"
        parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="colorSurface">@color/ninebot_surface</item>
        <item name="colorOnSurface">@color/ninebot_text</item>
        <item name="colorOnBackground">@color/ninebot_text</item>
        <item name="android:textColorPrimary">@color/ninebot_text</item>
        <item name="android:textColorSecondary">@color/ninebot_muted</item>
        <item name="android:textColorHint">@color/ninebot_muted</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay.BlackBox.Ninebot.MaterialAlertDialog</item>
    </style>

    <style name="ShapeAppearanceOverlay.BlackBox.Ninebot.MaterialAlertDialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>

</resources>
