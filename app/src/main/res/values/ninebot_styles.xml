<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.BlackBox.Ninebot.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/ninebot_surface</item>
        <item name="cardCornerRadius">@dimen/ninebot_card_radius</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/ninebot_line</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.BlackBox.Ninebot.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="android:minHeight">@dimen/ninebot_control_height</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/ninebot_on_blue</item>
        <item name="backgroundTint">@color/ninebot_blue</item>
        <item name="cornerRadius">@dimen/ninebot_control_radius</item>
    </style>

    <style name="Widget.BlackBox.Ninebot.Button.Secondary" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/ninebot_control_height</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/ninebot_blue</item>
        <item name="backgroundTint">@color/ninebot_surface</item>
        <item name="cornerRadius">@dimen/ninebot_control_radius</item>
        <item name="strokeColor">@color/ninebot_line</item>
    </style>

    <style name="Widget.BlackBox.Ninebot.Button.Action" parent="Widget.MaterialComponents.Button">
        <item name="android:minHeight">@dimen/ninebot_control_height</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/ninebot_blue</item>
        <item name="backgroundTint">@color/ninebot_surface_soft</item>
        <item name="cornerRadius">@dimen/ninebot_control_radius</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="Widget.BlackBox.Ninebot.Button.Warning" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:minHeight">@dimen/ninebot_control_height</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/ninebot_warning</item>
        <item name="backgroundTint">@color/ninebot_warning_soft</item>
        <item name="cornerRadius">@dimen/ninebot_control_radius</item>
        <item name="strokeColor">@color/ninebot_warning</item>
    </style>

    <style name="Widget.BlackBox.Ninebot.Button.Voltage" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/ninebot_blue</item>
        <item name="backgroundTint">@color/ninebot_surface</item>
        <item name="cornerRadius">16dp</item>
        <item name="strokeColor">@color/ninebot_line</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.BlackBox.Ninebot.StepNumber" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:layout_width">30dp</item>
        <item name="android:layout_height">30dp</item>
        <item name="android:background">@drawable/bg_ninebot_step_circle</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/ninebot_on_blue</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.BlackBox.Ninebot.Section" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textColor">@color/ninebot_text</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.BlackBox.Ninebot.Body" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textColor">@color/ninebot_text</item>
    </style>

    <style name="TextAppearance.BlackBox.Ninebot.Muted" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textColor">@color/ninebot_muted</item>
    </style>
</resources>
