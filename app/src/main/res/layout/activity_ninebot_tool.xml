<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/ninebot_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ninebot_background"
    android:fitsSystemWindows="false"
    tools:context="com.bfgtools.calibration.core.MainActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/ninebot_toolbar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/ninebot_surface"
        android:minHeight="68dp"
        android:paddingStart="6dp"
        android:paddingEnd="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:subtitleTextColor="@color/ninebot_muted"
        app:title="@string/ninebot_title"
        app:titleTextColor="@color/ninebot_text" />

    <ViewFlipper
        android:id="@+id/ninebot_pages"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:animateFirstView="false"
        app:layout_constraintBottom_toTopOf="@id/ninebot_bottom_nav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ninebot_toolbar">

        <include layout="@layout/page_ninebot_home" />
        <include layout="@layout/page_ninebot_vehicles" />
        <include layout="@layout/page_ninebot_operation" />
        <include layout="@layout/page_ninebot_settings" />
        <include layout="@layout/page_ninebot_write_complete" />
    </ViewFlipper>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/ninebot_bottom_nav"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/ninebot_surface"
        app:itemIconTint="@color/ninebot_nav_selector"
        app:itemRippleColor="@color/ninebot_surface_soft"
        app:itemTextColor="@color/ninebot_nav_selector"
        app:labelVisibilityMode="labeled"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:menu="@menu/menu_ninebot_tool" />

    <WebView
        android:id="@+id/bfg_prototype_web"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/ninebot_background"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
