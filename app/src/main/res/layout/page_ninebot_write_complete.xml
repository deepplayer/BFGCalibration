<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/write_complete_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/ninebot_page_padding"
        android:paddingTop="14dp"
        android:paddingEnd="@dimen/ninebot_page_padding"
        android:paddingBottom="28dp">

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.BlackBox.Ninebot.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/ninebot_surface_soft"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="15dp">

                <TextView
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_ninebot_info"
                    android:gravity="center"
                    android:text="✓"
                    android:textColor="@color/ninebot_blue"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="11dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="原参数已自动备份"
                        android:textColor="@color/ninebot_blue"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/write_complete_backup_summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="可随时恢复"
                        android:textAppearance="@style/TextAppearance.BlackBox.Ninebot.Muted"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/write_complete_backup_view"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="9dp"
                    android:text="查看"
                    android:textColor="@color/ninebot_blue"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_ninebot_success_circle"
            android:gravity="center"
            android:text="✓"
            android:textColor="@color/ninebot_on_blue"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/write_complete_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:text="写入并回读成功"
            android:textColor="@color/ninebot_text"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/write_complete_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="参数已经生效，无需返回页面顶部查看。"
            android:textAppearance="@style/TextAppearance.BlackBox.Ninebot.Muted" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.BlackBox.Ninebot.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="写入前"
                        android:textAppearance="@style/TextAppearance.BlackBox.Ninebot.Muted" />

                    <TextView
                        android:id="@+id/write_complete_before"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="60V · 26Ah"
                        android:textColor="@color/ninebot_text"
                        android:textSize="17sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:gravity="center"
                    android:text="→"
                    android:textColor="@color/ninebot_blue"
                    android:textSize="22sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="写入后"
                        android:textAppearance="@style/TextAppearance.BlackBox.Ninebot.Muted" />

                    <TextView
                        android:id="@+id/write_complete_after"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="60V · 36Ah"
                        android:textColor="@color/ninebot_text"
                        android:textSize="17sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_ninebot_good_badge"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/write_complete_check_command"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="✓  写入指令已完成"
                android:textColor="@color/ninebot_good"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/write_complete_check_readback"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:text="✓  容量档位回读一致"
                android:textColor="@color/ninebot_good"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:text="✓  首次备份仍保留"
                android:textColor="@color/ninebot_good"
                android:textStyle="bold" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/write_complete_done_button"
            style="@style/Widget.BlackBox.Ninebot.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="完成" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/write_complete_restore_button"
            style="@style/Widget.BlackBox.Ninebot.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="恢复原参数" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/write_complete_export_diagnostic_button"
            style="@style/Widget.BlackBox.Ninebot.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="导出本次诊断数据" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
