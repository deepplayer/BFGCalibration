<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/ninebot_page_padding"
        android:paddingTop="14dp"
        android:paddingEnd="@dimen/ninebot_page_padding"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ninebot_settings_data"
            android:textAppearance="@style/TextAppearance.BlackBox.Ninebot.Section" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.BlackBox.Ninebot.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/ninebot_card_padding">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ninebot_settings_source_label"
                    android:textAppearance="@style/TextAppearance.BlackBox.Ninebot.Muted" />

                <TextView
                    android:id="@+id/settings_source"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/ninebot_settings_source_value"
                    android:textAppearance="@style/TextAppearance.BlackBox.Ninebot.Section" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/settings_go_vehicles"
                    style="@style/Widget.BlackBox.Ninebot.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/ninebot_action_switch_vehicle" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ninebot_section_gap"
            android:text="九号出行来源"
            android:textAppearance="@style/TextAppearance.BlackBox.Ninebot.Section" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.BlackBox.Ninebot.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/ninebot_card_padding">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="工具不内置九号出行。可手动选择 APK，或在已 Root 的手机上读取本机已安装的九号出行。"
                    android:textAppearance="@style/TextAppearance.BlackBox.Ninebot.Muted" />

                <TextView
                    android:id="@+id/imported_ninebot_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@color/ninebot_surface_soft"
                    android:padding="12dp"
                    android:text="尚未导入九号出行"
                    android:textAppearance="@style/TextAppearance.BlackBox.Ninebot.Body" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/import_ninebot_apk_button"
                    style="@style/Widget.BlackBox.Ninebot.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="导入九号出行 APK" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/clear_virtual_ninebot_button"
                    style="@style/Widget.BlackBox.Ninebot.Button.Warning"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="清空已导入九号出行数据" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ninebot_section_gap"
            android:text="数据读取方式"
            android:textAppearance="@style/TextAppearance.BlackBox.Ninebot.Section" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.BlackBox.Ninebot.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/ninebot_card_padding">

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/root_mode_switch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="52dp"
                    android:text="Root 工作模式"
                    android:textColor="@color/ninebot_text"
                    app:useMaterialThemeColors="true" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="开启后直接读取原机九号出行数据库；关闭后读取工具中已导入九号出行的数据库。"
                    android:textAppearance="@style/TextAppearance.BlackBox.Ninebot.Muted" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/root_fallback_switch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:minHeight="52dp"
                    android:text="读取失败自动回退"
                    android:textColor="@color/ninebot_text"
                    app:useMaterialThemeColors="true" />

                <TextView
                    android:id="@+id/root_mode_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@color/ninebot_surface_soft"
                    android:padding="12dp"
                    android:text="普通模式：读取已导入九号数据库"
                    android:textAppearance="@style/TextAppearance.BlackBox.Ninebot.Body" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ninebot_section_gap"
            android:text="@string/ninebot_settings_security"
            android:textAppearance="@style/TextAppearance.BlackBox.Ninebot.Section" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.BlackBox.Ninebot.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/ninebot_card_padding">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ninebot_settings_default"
                    android:textAppearance="@style/TextAppearance.BlackBox.Ninebot.Body" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/ninebot_settings_backup"
                    android:textAppearance="@style/TextAppearance.BlackBox.Ninebot.Body" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/ninebot_settings_scope"
                    android:textAppearance="@style/TextAppearance.BlackBox.Ninebot.Body" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ninebot_section_gap"
            android:text="连接诊断"
            android:textAppearance="@style/TextAppearance.BlackBox.Ninebot.Section" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.BlackBox.Ninebot.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/ninebot_card_padding">

                <TextView
                    android:id="@+id/diagnostic_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="尚无连接诊断数据。连接车辆后可导出最近一次记录。"
                    android:textAppearance="@style/TextAppearance.BlackBox.Ninebot.Muted" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/export_diagnostic_button"
                    style="@style/Widget.BlackBox.Ninebot.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="导出最近一次诊断数据" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ninebot_section_gap"
            android:text="@string/ninebot_about_section"
            android:textAppearance="@style/TextAppearance.BlackBox.Ninebot.Section" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.BlackBox.Ninebot.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/ninebot_card_padding">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ninebot_about_name"
                    android:textAppearance="@style/TextAppearance.BlackBox.Ninebot.Section" />

                <TextView
                    android:id="@+id/settings_about_version"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="版本："
                    android:textAppearance="@style/TextAppearance.BlackBox.Ninebot.Muted" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/ninebot_about_nature_label"
                    android:textAppearance="@style/TextAppearance.BlackBox.Ninebot.Muted" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/ninebot_about_nature"
                    android:textColor="@color/ninebot_good"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/ninebot_about_statement_label"
                    android:textAppearance="@style/TextAppearance.BlackBox.Ninebot.Muted" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/ninebot_about_statement"
                    android:textAppearance="@style/TextAppearance.BlackBox.Ninebot.Body" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/settings_view_license"
                    style="@style/Widget.BlackBox.Ninebot.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/ninebot_about_view_license" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
