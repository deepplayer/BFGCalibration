<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="false"
    android:overScrollMode="ifContentScrolls">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="22dp"
        android:paddingEnd="22dp"
        android:paddingBottom="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_ninebot_good_badge"
            android:paddingHorizontal="11dp"
            android:paddingVertical="5dp"
            android:text="永久免费 · 第三方工具"
            android:textColor="@color/ninebot_good"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/ninebot_agreement_title"
            android:textColor="@color/ninebot_text"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/ninebot_agreement_body"
            android:textAppearance="@style/TextAppearance.BlackBox.Ninebot.Body"
            android:lineSpacingExtra="3dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_ninebot_error"
            android:padding="14dp"
            android:text="@string/ninebot_agreement_prohibited"
            android:textColor="@color/ninebot_danger"
            android:textStyle="bold"
            android:lineSpacingExtra="3dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/ninebot_agreement_report"
            android:textAppearance="@style/TextAppearance.BlackBox.Ninebot.Muted"
            android:lineSpacingExtra="2dp" />
    </LinearLayout>
</ScrollView>
