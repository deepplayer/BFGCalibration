<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/pairing_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ninebot_background"
    >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/pairing_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ninebot_background"
        android:minHeight="72dp"
        android:paddingEnd="12dp"
        app:navigationIcon="@drawable/ic_ninebot_back"
        app:navigationIconTint="@color/ninebot_text"
        app:subtitle="核对完整序列号后，在车上确认"
        app:subtitleTextColor="@color/ninebot_muted"
        app:title="临时密钥配对"
        app:titleTextColor="@color/ninebot_text" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/ninebot_page_padding"
            android:paddingTop="8dp"
            android:paddingEnd="@dimen/ninebot_page_padding"
            android:paddingBottom="28dp">

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.BlackBox.Ninebot.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/ninebot_card_padding">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="配对流程"
                        android:textAppearance="@style/TextAppearance.BlackBox.Ninebot.Section" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="1  将车辆唤醒并靠近手机"
                        android:textAppearance="@style/TextAppearance.BlackBox.Ninebot.Body"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="2  扫描并核对完整序列号"
                        android:textAppearance="@style/TextAppearance.BlackBox.Ninebot.Body"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="3  点击车辆，确认已开机后发起配对"
                        android:textAppearance="@style/TextAppearance.BlackBox.Ninebot.Body"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="4  按车上按钮完成确认"
                        android:textAppearance="@style/TextAppearance.BlackBox.Ninebot.Body"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/pairing_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_ninebot_info"
                android:padding="13dp"
                android:text="关闭其他正在连接车辆的应用或手机，然后开始扫描。"
                android:textAppearance="@style/TextAppearance.BlackBox.Ninebot.Body" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/pairing_scan_button"
                style="@style/Widget.BlackBox.Ninebot.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:minHeight="56dp"
                android:text="扫描附近车辆"
                android:textAllCaps="false"
                app:icon="@drawable/ic_ninebot_bluetooth"
                app:iconGravity="textStart"
                app:iconPadding="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:layout_marginTop="18dp"
                android:layout_marginEnd="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="附近车辆"
                    android:textAppearance="@style/TextAppearance.BlackBox.Ninebot.Section" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="点击序列号继续"
                    android:textAppearance="@style/TextAppearance.BlackBox.Ninebot.Muted" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/pairing_candidates"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:orientation="vertical" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/pairing_back_button"
                style="@style/Widget.BlackBox.Ninebot.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="返回 BFG 电量校准"
                android:textAllCaps="false" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    </LinearLayout>

    <WebView
        android:id="@+id/pairing_prototype_web"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/ninebot_background"
        android:overScrollMode="never" />
</FrameLayout>
