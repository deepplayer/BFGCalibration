<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/home_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/ninebot_page_padding"
        android:paddingTop="14dp"
        android:paddingEnd="@dimen/ninebot_page_padding"
        android:paddingBottom="28dp">

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.BlackBox.Ninebot.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/ninebot_card_padding">

                <FrameLayout
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_ninebot_metric"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="车辆"
                        android:src="@drawable/ic_ninebot_vehicle"
                        app:tint="@color/ninebot_blue" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="13dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="当前车辆"
                        android:textAppearance="@style/TextAppearance.BlackBox.Ninebot.Muted" />

                    <TextView
                        android:id="@+id/current_vehicle_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/ninebot_vehicle_none"
                        android:textColor="@color/ninebot_text"
                        android:textIsSelectable="true"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/current_vehicle_meta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/ninebot_vehicle_none_detail"
                        android:textAppearance="@style/TextAppearance.BlackBox.Ninebot.Muted" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/current_vehicle_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_ninebot_good_badge"
                        android:paddingHorizontal="9dp"
                        android:paddingVertical="5dp"
                        android:text="待连接"
                        android:textColor="@color/ninebot_good"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/switch_vehicle_button"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginTop="2dp"
                        android:minWidth="0dp"
                        android:paddingHorizontal="8dp"
                        android:text="切换"
                        android:textAllCaps="false"
                        android:textColor="@color/ninebot_blue" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.BlackBox.Ninebot.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/ninebot_card_padding">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_ninebot_metric"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="九号出行"
                            android:src="@drawable/ic_ninebot_phone"
                            app:tint="@color/ninebot_blue" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="13dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="九号出行"
                            android:textAppearance="@style/TextAppearance.BlackBox.Ninebot.Muted" />

                        <TextView
                            android:id="@+id/source_mode"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/ninebot_source_waiting"
                            android:textColor="@color/ninebot_text"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/source_detail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:text="登录账号后可读取车辆凭据"
                            android:textAppearance="@style/TextAppearance.BlackBox.Ninebot.Muted" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/source_ready_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_ninebot_good_badge"
                        android:paddingHorizontal="9dp"
                        android:paddingVertical="5dp"
                        android:text="未导入"
                        android:textColor="@color/ninebot_good"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="13dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/home_import_ninebot_button"
                        style="@style/Widget.BlackBox.Ninebot.Button.Secondary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="5dp"
                        android:layout_weight="1"
                        android:insetLeft="0dp"
                        android:insetRight="0dp"
                        android:maxLines="1"
                        android:minHeight="48dp"
                        android:text="导入九号出行 APK"
                        android:textAllCaps="false"
                        android:textSize="12sp"
                        app:icon="@drawable/ic_ninebot_download"
                        app:iconGravity="textStart"
                        app:iconPadding="5dp"
                        app:iconSize="18dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/virtual_env_button"
                        style="@style/Widget.BlackBox.Ninebot.Button.Primary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:layout_weight="1"
                        android:insetLeft="0dp"
                        android:insetRight="0dp"
                        android:maxLines="1"
                        android:minHeight="48dp"
                        android:text="登录九号出行"
                        android:textAllCaps="false"
                        android:textSize="14sp"
                        app:icon="@drawable/ic_ninebot_login"
                        app:iconGravity="textStart"
                        app:iconPadding="3dp"
                        app:iconSize="18dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/source_vehicle_count"
                    android:layout_width="1dp"
                    android:layout_height="1dp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/source_sync_time"
                    android:layout_width="1dp"
                    android:layout_height="1dp"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/home_sync_button"
                    android:layout_width="1dp"
                    android:layout_height="1dp"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:layout_marginTop="18dp"
            android:layout_marginEnd="3dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="开始使用"
                android:textAppearance="@style/TextAppearance.BlackBox.Ninebot.Section" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="请选择一种连接方式"
                android:textAppearance="@style/TextAppearance.BlackBox.Ninebot.Muted" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/button_read"
            style="@style/Widget.BlackBox.Ninebot.Card"
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:layout_marginTop="9dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="@color/ninebot_blue"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="18dp">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:contentDescription="连接车辆"
                    android:src="@drawable/ic_ninebot_bluetooth" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="连接车辆"
                        android:textColor="@color/ninebot_on_blue"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:alpha="0.86"
                        android:maxLines="2"
                        android:text="使用已有凭据连接，成功后核对车辆信息"
                        android:textColor="@color/ninebot_on_blue"
                        android:textSize="13sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="进入"
                    android:src="@drawable/ic_ninebot_chevron"
                    app:tint="@color/ninebot_on_blue" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/pairing_lab_button"
            style="@style/Widget.BlackBox.Ninebot.Card"
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:layout_marginTop="10dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="18dp">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:contentDescription="临时密钥配对"
                    android:src="@drawable/ic_ninebot_key" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="临时密钥配对"
                        android:textColor="@color/ninebot_text"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:maxLines="2"
                        android:text="没有可用凭据时，在车上确认并建立新配对"
                        android:textAppearance="@style/TextAppearance.BlackBox.Ninebot.Muted"
                        android:textSize="13sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="进入"
                    android:src="@drawable/ic_ninebot_chevron"
                    app:tint="@color/ninebot_blue" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="11dp"
            android:background="@drawable/bg_ninebot_info"
            android:padding="12dp"
            android:text="普通连接遇到认证无回应时，会询问是否进入临时密钥配对，不会自动覆盖原凭据。"
            android:textAppearance="@style/TextAppearance.BlackBox.Ninebot.Muted" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="11dp"
            android:background="@drawable/bg_ninebot_info"
            android:ellipsize="end"
            android:maxLines="3"
            android:paddingHorizontal="13dp"
            android:paddingVertical="10dp"
            android:text="@string/ninebot_status_initial"
            android:textAppearance="@style/TextAppearance.BlackBox.Ninebot.Body" />

        <TextView
            android:id="@+id/home_soc_value"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/home_voltage_band_value"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/home_capacity_value"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/home_read_state"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/write_entry_button"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_compare"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
