<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/operation_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/ninebot_page_padding"
        android:paddingTop="14dp"
        android:paddingEnd="@dimen/ninebot_page_padding"
        android:paddingBottom="28dp">

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/mode_toggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:checkedButton="@id/read_only_tab"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/read_only_tab"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/ninebot_mode_read"
                android:textAllCaps="false" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/calibrate_tab"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/ninebot_mode_write"
                android:textAllCaps="false" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/operation_status_card"
            style="@style/Widget.BlackBox.Ninebot.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            app:cardBackgroundColor="@color/ninebot_surface_soft"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <ProgressBar
                    android:id="@+id/operation_progress"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:indeterminate="true"
                    android:indeterminateTint="@color/ninebot_blue"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/operation_state"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="@string/ninebot_operation_waiting"
                    android:textAppearance="@style/TextAppearance.BlackBox.Ninebot.Body" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/connected_vehicle_card"
            style="@style/Widget.BlackBox.Ninebot.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/ninebot_card_padding">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="核对车辆与电池信息"
                    android:textAppearance="@style/TextAppearance.BlackBox.Ninebot.Section" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/connected_vehicle_identity"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/ninebot_text"
                            android:textSize="19sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/connected_vehicle_model"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:textAppearance="@style/TextAppearance.BlackBox.Ninebot.Muted" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/bg_ninebot_good_badge"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="5dp"
                        android:text="蓝牙已连接"
                        android:textColor="@color/ninebot_good"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_ninebot_metric"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="13dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="当前电量"
                            android:textAppearance="@style/TextAppearance.BlackBox.Ninebot.Muted" />

                        <TextView
                            android:id="@+id/connected_soc_value"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center"
                            android:maxLines="1"
                            android:text="--%"
                            android:textColor="@color/ninebot_text"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            app:autoSizeMaxTextSize="24sp"
                            app:autoSizeMinTextSize="15sp"
                            app:autoSizeStepGranularity="1sp"
                            app:autoSizeTextType="uniform" />
                    </LinearLayout>

                    <Space
                        android:layout_width="10dp"
                        android:layout_height="1dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_ninebot_metric"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="13dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="电池电压"
                            android:textAppearance="@style/TextAppearance.BlackBox.Ninebot.Muted" />

                        <TextView
                            android:id="@+id/connected_battery_voltage_value"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center"
                            android:maxLines="1"
                            android:text="--V"
                            android:textColor="@color/ninebot_text"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            app:autoSizeMaxTextSize="24sp"
                            app:autoSizeMinTextSize="14sp"
                            app:autoSizeStepGranularity="1sp"
                            app:autoSizeTextType="uniform" />
                    </LinearLayout>

                    <Space
                        android:layout_width="10dp"
                        android:layout_height="1dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_ninebot_metric"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="13dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="剩余容量"
                            android:textAppearance="@style/TextAppearance.BlackBox.Ninebot.Muted" />

                        <TextView
                            android:id="@+id/connected_remaining_capacity_value"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center"
                            android:maxLines="1"
                            android:text="--Ah"
                            android:textColor="@color/ninebot_text"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            app:autoSizeMaxTextSize="22sp"
                            app:autoSizeMinTextSize="14sp"
                            app:autoSizeStepGranularity="1sp"
                            app:autoSizeTextType="uniform" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_ninebot_metric"
                    android:orientation="horizontal"
                    android:paddingVertical="12dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="仪表校准电压"
                            android:textAppearance="@style/TextAppearance.BlackBox.Ninebot.Muted" />

                        <TextView
                            android:id="@+id/connected_dashboard_voltage_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="--V"
                            android:textColor="@color/ninebot_text"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/ninebot_line" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="计量校准电压"
                            android:textAppearance="@style/TextAppearance.BlackBox.Ninebot.Muted" />

                        <TextView
                            android:id="@+id/connected_voltage_group_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="--V"
                            android:textColor="@color/ninebot_text"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/ninebot_line" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="计量校准容量"
                            android:textAppearance="@style/TextAppearance.BlackBox.Ninebot.Muted" />

                        <TextView
                            android:id="@+id/connected_capacity_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="--Ah"
                            android:textColor="@color/ninebot_text"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/connected_firmware_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="固件版本"
                    android:textAppearance="@style/TextAppearance.BlackBox.Ninebot.Section" />

                <LinearLayout
                    android:id="@+id/connected_firmware_rows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="42dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="仪表"
                            android:textAppearance="@style/TextAppearance.BlackBox.Ninebot.Muted" />

                        <TextView
                            android:id="@+id/firmware_dashboard_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--"
                            android:textColor="@color/ninebot_text"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/ninebot_line" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="42dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="计量模块"
                            android:textAppearance="@style/TextAppearance.BlackBox.Ninebot.Muted" />

                        <TextView
                            android:id="@+id/firmware_meter_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="--"
                            android:textColor="@color/ninebot_text"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/connected_mode_notice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_ninebot_good_badge"
                    android:padding="13dp"
                    android:textColor="@color/ninebot_good"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/connected_calibrate_button"
                    style="@style/Widget.BlackBox.Ninebot.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:minHeight="56dp"
                    android:text="信息无误，进入电量校准"
                    android:textAllCaps="false" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/result_card"
            style="@style/Widget.BlackBox.Ninebot.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/ninebot_card_padding">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ninebot_result_title"
                    android:textAppearance="@style/TextAppearance.BlackBox.Ninebot.Section" />

                <TextView
                    android:id="@+id/result"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:text="@string/ninebot_result_empty"
                    android:textAppearance="@style/TextAppearance.BlackBox.Ninebot.Body"
                    android:textIsSelectable="true" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:id="@+id/write_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.BlackBox.Ninebot.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                app:cardBackgroundColor="@color/ninebot_surface_soft"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/calibration_ready_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_ninebot_good_badge"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="5dp"
                        android:text="车辆已确认 · 支持校准"
                        android:textColor="@color/ninebot_good"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/calibration_vehicle_identity"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textColor="@color/ninebot_text"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/calibration_current_summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textAppearance="@style/TextAppearance.BlackBox.Ninebot.Body" />

                    <TextView
                        android:id="@+id/calibration_firmware_summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textAppearance="@style/TextAppearance.BlackBox.Ninebot.Muted" />

                    <TextView
                        android:id="@+id/calibration_mode_summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:textColor="@color/ninebot_blue"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.BlackBox.Ninebot.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/ninebot_warning_soft"
                app:strokeColor="@color/ninebot_warning">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ninebot_write_guard_title"
                        android:textAppearance="@style/TextAppearance.BlackBox.Ninebot.Section"
                        android:textColor="@color/ninebot_warning" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/ninebot_write_guard_body"
                        android:textAppearance="@style/TextAppearance.BlackBox.Ninebot.Muted" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/backup_status_card"
                style="@style/Widget.BlackBox.Ninebot.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/ninebot_card_padding">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/ninebot_backup_title"
                        android:textAppearance="@style/TextAppearance.BlackBox.Ninebot.Section" />

                    <TextView
                        android:id="@+id/backup_view"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:text="@string/ninebot_backup_empty"
                        android:textAppearance="@style/TextAppearance.BlackBox.Ninebot.Muted"
                        android:textIsSelectable="true" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.BlackBox.Ninebot.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/ninebot_card_padding">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/ninebot_profile_title"
                            android:textAppearance="@style/TextAppearance.BlackBox.Ninebot.Section" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/ninebot_profile_limit"
                            android:textAppearance="@style/TextAppearance.BlackBox.Ninebot.Muted" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/ninebot_voltage_title"
                        android:textAppearance="@style/TextAppearance.BlackBox.Ninebot.Muted" />

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/voltage_group"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:checkedButton="@id/voltage_60"
                        app:selectionRequired="true"
                        app:singleSelection="true">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/voltage_48"
                            style="@style/Widget.BlackBox.Ninebot.Button.Voltage"
                            android:layout_width="0dp"
                            android:layout_height="64dp"
                            android:layout_weight="1"
                            android:text="@string/ninebot_voltage_48" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/voltage_60"
                            style="@style/Widget.BlackBox.Ninebot.Button.Voltage"
                            android:layout_width="0dp"
                            android:layout_height="64dp"
                            android:layout_weight="1"
                            android:checked="true"
                            android:text="@string/ninebot_voltage_60" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/voltage_72"
                            style="@style/Widget.BlackBox.Ninebot.Button.Voltage"
                            android:layout_width="0dp"
                            android:layout_height="64dp"
                            android:layout_weight="1"
                            android:text="@string/ninebot_voltage_72" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/capacity_picker_button"
                        style="@style/Widget.BlackBox.Ninebot.Button.Secondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="center_vertical|start"
                        android:minHeight="58dp"
                        android:text="@string/ninebot_capacity_picker_default"
                        android:textAllCaps="false" />

                    <LinearLayout
                        android:id="@+id/capacity_options_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="@string/ninebot_capacity_sorted_hint"
                            android:textAppearance="@style/TextAppearance.BlackBox.Ninebot.Muted" />

                        <LinearLayout
                            android:id="@+id/capacity_grid"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:orientation="vertical" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/target_summary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:background="@color/ninebot_surface_soft"
                        android:padding="12dp"
                        android:text="@string/ninebot_target_empty"
                        android:textAppearance="@style/TextAppearance.BlackBox.Ninebot.Body" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/ninebot_write_scope"
                        android:textColor="@color/ninebot_danger"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/write_button"
                        style="@style/Widget.BlackBox.Ninebot.Button.Warning"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="临时写入计量模块并回读" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="实验功能：仅修改仪表电压配置。是否断电保持，以及容量是否同步变化，需实车验证。"
                        android:textAppearance="@style/TextAppearance.BlackBox.Ninebot.Muted" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/write_dis_voltage_button"
                        style="@style/Widget.BlackBox.Ninebot.Button.Secondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:minHeight="52dp"
                        android:text="实验：写入仪表电压配置" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/restore_dis_voltage_button"
                        style="@style/Widget.BlackBox.Ninebot.Button.Secondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:minHeight="48dp"
                        android:text="恢复首次读取的仪表配置" />

                    <LinearLayout
                        android:id="@+id/write_progress_panel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_ninebot_info"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="14dp"
                        android:visibility="gone">

                        <ProgressBar
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:indeterminate="true"
                            android:indeterminateTint="@color/ninebot_blue" />

                        <TextView
                            android:id="@+id/write_progress_text"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:text="@string/ninebot_write_progress"
                            android:textAppearance="@style/TextAppearance.BlackBox.Ninebot.Body" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/write_inline_result"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/bg_ninebot_good_badge"
                        android:orientation="vertical"
                        android:padding="14dp"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/write_inline_result_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/ninebot_write_success_title"
                            android:textAppearance="@style/TextAppearance.BlackBox.Ninebot.Section"
                            android:textColor="@color/ninebot_good" />

                        <TextView
                            android:id="@+id/write_inline_result_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:textColor="@color/ninebot_text"
                            android:textAppearance="@style/TextAppearance.BlackBox.Ninebot.Body" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/restore_button"
                        style="@style/Widget.BlackBox.Ninebot.Button.Secondary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:text="@string/ninebot_action_restore" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/technical_toggle_button"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/ninebot_technical_toggle"
            android:textAllCaps="false"
            android:textColor="@color/ninebot_muted" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/technical_details"
            style="@style/Widget.BlackBox.Ninebot.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/ninebot_card_padding">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ninebot_log_title"
                    android:textAppearance="@style/TextAppearance.BlackBox.Ninebot.Section" />

                <TextView
                    android:id="@+id/log_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="monospace"
                    android:minHeight="80dp"
                    android:textAppearance="@style/TextAppearance.BlackBox.Ninebot.Muted"
                    android:textIsSelectable="true" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
